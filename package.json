{
  "name": "pomo",
  "version": "0.1.0",
  "description": "A cute pomodoro timer with little animated friends who live on your screen",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pomo.timer",
    "productName": "Pomo",
    "files": [
      "src/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "afterPack": "build/afterPack.js",
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Pomo-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Pomo-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Pomo",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "amlkong",
        "repo": "pomodoro"
      }
    ]
  },
  "author": "amlkong",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
